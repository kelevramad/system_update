{
  "name": "system-update-cli",
  "version": "2.0.0",
  "private": true,
  "description": "Cross-platform package manager scanner/updater",
  "bin": {
    "system-update": "./system_update.js"
  },
  "scripts": {
    "start": "node system_update.js",
    "help": "node system_update.js --help",
    "test": "node --test --test-reporter spec tests/*.test.js",
    "coverage": "c8 -r text -r html node --test --test-reporter spec tests/*.test.js",
    "test:all": "npm test && npm run coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "c8": "^10.1.2"
  }
}